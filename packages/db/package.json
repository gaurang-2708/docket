{
  "name": "@docket/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate",
    "migrate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "migrate:dev": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate dev",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "postinstall": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "pg": "^8.13.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "prisma": "^6.3.0",
    "@types/pg": "^8.11.10",
    "@types/bcryptjs": "^2.4.6"
  }
}
