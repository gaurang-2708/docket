# Local Postgres cluster created by `npm run db:init` (port 54332, trust auth on 127.0.0.1 only)
DATABASE_URL=postgresql://docket@127.0.0.1:54332/docket
# Where `npm run db:init` creates the cluster
PGDATA_DIR=./.pgdata
PG_BIN=/usr/lib/postgresql/16/bin
PG_PORT=54332
# Change this for anything beyond a local demo
JWT_SECRET=change-me-to-a-long-random-string
GATEWAY_PORT=4300
AUTH_PORT=4301
AUTH_URL=http://127.0.0.1:4301
